# Kavi — per-machine environment variables.
#
# Copy this file to .kavi.env and edit the paths to match your machine:
#   cp .kavi.env.example .kavi.env
#
# Then source it before running any script that needs SDK/NDK paths:
#   source .kavi.env
#
# .kavi.env is gitignored — never commit it.

export QAIRT_SDK_ROOT="$HOME/Qualcomm/AIStack/QAIRT/2.31.0.250130"
export ANDROID_NDK_ROOT="/path/to/your/ndk/26.1.10909125"  # ← EDIT THIS if different
