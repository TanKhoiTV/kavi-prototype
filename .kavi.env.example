# Kavi — per-machine environment variables.
#
# Copy this file to .kavi.env and edit the paths to match your machine:
#   cp .kavi.env.example .kavi.env
#
# Then load it before running anything that needs SDK/NDK paths:
#   bash / Git Bash / WSL:  source .kavi.env
#   PowerShell (Windows):   see the block at the bottom of this file
#
# .kavi.env is gitignored — never commit it.

export QAIRT_SDK_ROOT="${QAIRT_SDK_ROOT:-$HOME/Qualcomm/AIStack/QAIRT/2.31.0.250130}"
export ANDROID_NDK_ROOT="${ANDROID_NDK_ROOT:-/path/to/your/ndk/26.1.10909125}"  # <-- EDIT

# --- Windows / PowerShell equivalent -----------------------------------------
# Git Bash on Windows can source this file as-is. In PowerShell, set the two
# variables directly, e.g.:
#
#   $env:QAIRT_SDK_ROOT   = "$HOME\Qualcomm\AIStack\QAIRT\2.31.0.250130"
#   $env:ANDROID_NDK_ROOT = "C:\Android\Sdk\ndk\26.1.10909125"
#
# For QAIRT conversion on Windows, dot-source scripts\qairt-env.ps1 instead.
# ----------------------------------------------------------------------------
